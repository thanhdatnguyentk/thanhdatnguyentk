---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import CaseVisual from '../../components/CaseVisual.astro';
import I18nText from '../../components/I18nText.astro';
import { projects, profileInfo, uiStrings, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, index) => {
    const nextProject = projects[(index + 1) % projects.length];
    return {
      params: { slug: project.slug },
      props: { project, nextProject },
    };
  });
}

interface Props {
  project: Project;
  nextProject: Project;
}

const { project, nextProject } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const headlineWordsEn = project.headline.en.split(' ');
const headlineWordsVi = project.headline.vi.split(' ');
const labels = uiStrings.caseDetail;
---

<Base
  title={`${project.title} (${project.caseLabel}) / ${profileInfo.name}`}
  description={project.longDescription.en}
  namespace="single"
>
  <Nav />
  <main class="l-main" id="main" tabindex="-1">
    <div class="p-single" id="single-page">
      <div class="p-single-head">
        <p class="p-single-head__eyebrow u-en">
          {project.caseLabel} · {project.category}
        </p>
        <h1 class="p-single-head__title">
          <span data-i18n-lang="en">
            {headlineWordsEn.map((w, idx) => (
              <span class="word">
                <span class="word__inner" style={`transition-delay: ${Math.min(idx * 28, 600)}ms`}>
                  {w}
                </span>
              </span>
            ))}
          </span>
          <span data-i18n-lang="vi">
            {headlineWordsVi.map((w, idx) => (
              <span class="word">
                <span class="word__inner" style={`transition-delay: ${Math.min(idx * 28, 600)}ms`}>
                  {w}
                </span>
              </span>
            ))}
          </span>
          <span data-i18n-lang="ja">
            <span class="word">
              <span class="word__inner" style="transition-delay: 80ms">
                {project.headline.ja}
              </span>
            </span>
          </span>
        </h1>
      </div>

      <section class="p-single-contents">
        <div class="category">
          <span class="c-tag">{project.category}</span>
          {project.tech.map((t) => (
            <span class="c-tag c-tag--outline">{t}</span>
          ))}
        </div>

        <div class="scope">
          <div class="scope__item">
            <span class="scope__title"><I18nText t={labels.role} /></span>
            <span class="scope__text"><I18nText t={project.scope.role} /></span>
          </div>
          <div class="scope__item">
            <span class="scope__title"><I18nText t={labels.domain} /></span>
            <span class="scope__text"><I18nText t={project.scope.domain} /></span>
          </div>
          <div class="scope__item">
            <span class="scope__title"><I18nText t={labels.stack} /></span>
            <span class="scope__text">{project.scope.stack}</span>
          </div>
        </div>

        <!-- Overview & Visual -->
        <div class="body-group">
          <h2 class="body-group__title">
            <I18nText t={labels.overview} />
          </h2>
          <div class="body-group__contents">
            <p>
              <b><I18nText t={project.longDescription} /></b>
            </p>
            <I18nText tag="p" t={project.story.motivation} />
            <div class="visual-box">
              <div style="width:230px;height:230px">
                <CaseVisual type={project.visualType} />
              </div>
            </div>
            <small class="caption">
              {project.caseLabel}: {project.title} — <I18nText t={project.scope.domain} />
            </small>
          </div>
        </div>

        <!-- Screenshots & Interactive Simulation Lab (if project has screenshots or interactive demo) -->
        {(project.screenshots || project.hasInteractiveDemo) && (
          <div class="body-group body-group--wide">
            <h2 class="body-group__title">
              <I18nText t={labels.screenshots} />
            </h2>
            <div class="body-group__contents body-group__contents--wide">
              {project.hasInteractiveDemo && (
                <div class="interactive-observatory" id="mini-galaxy-lab">
                  <div class="interactive-observatory__header">
                    <div class="interactive-observatory__title-group">
                      <span class="live-dot" aria-hidden="true"></span>
                      <span class="u-en interactive-observatory__badge">LIVE INTERACTIVE 3D PREVIEW</span>
                    </div>
                    <div class="interactive-observatory__modes" role="tablist">
                      <button type="button" class="sim-mode-btn is-active" data-sim-mode="galaxy">
                        🌌 28 kpc Galaxy
                      </button>
                      <button type="button" class="sim-mode-btn" data-sim-mode="solar">
                        🪐 Solar System &amp; Comet
                      </button>
                      <button type="button" class="sim-mode-btn" data-sim-mode="supernova">
                        💥 Supernova Lab
                      </button>
                    </div>
                  </div>
                  <div class="interactive-observatory__viewport">
                    <canvas id="portfolio-galaxy-canvas" width="760" height="420"></canvas>
                    <div class="interactive-observatory__hud">
                      <span id="sim-scale-readout">SCALE: 5.0 kpc (~16,300 ly) • R₀ = 8.178 kpc</span>
                      <span class="sim-hint">🖱 Kéo chuột để xoay 3D • Nhấn vào chế độ để chuyển cảnh</span>
                    </div>
                  </div>
                </div>
              )}

              {project.screenshots && project.screenshots.length > 0 && (
                <div class="screenshot-showcase" id="screenshot-showcase">
                  <div class="screenshot-tabs" role="tablist" aria-label="Project Screenshots">
                    {project.screenshots.map((shot, idx) => (
                      <button
                        type="button"
                        class={`screenshot-tab ${idx === 0 ? 'is-active' : ''}`}
                        data-shot-idx={idx}
                      >
                        <span class="screenshot-tab__num u-en">0{idx + 1}</span>
                        <span class="screenshot-tab__badge u-en">{shot.badge}</span>
                      </button>
                    ))}
                  </div>

                  <div class="screenshot-stage">
                    {project.screenshots.map((shot, idx) => (
                      <figure
                        class={`screenshot-slide ${idx === 0 ? 'is-active' : ''}`}
                        data-shot-slide={idx}
                      >
                        <div class="screenshot-frame" data-lightbox-src={`${baseUrl}${shot.src}`}>
                          <img
                            src={`${baseUrl}${shot.src}`}
                            alt={shot.title.en}
                            loading={idx === 0 ? 'eager' : 'lazy'}
                          />
                          <span class="screenshot-zoom-pill u-en">🔍 Click to Zoom</span>
                        </div>
                        <figcaption class="screenshot-caption">
                          <h3 class="screenshot-caption__title">
                            <I18nText t={shot.title} />
                          </h3>
                          <p class="screenshot-caption__desc">
                            <I18nText t={shot.caption} />
                          </p>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Architecture & Implementation -->
        <div class="body-group">
          <h2 class="body-group__title">
            <I18nText t={labels.architecture} />
          </h2>
          <div class="body-group__contents">
            <I18nText tag="p" t={project.story.architecture} />
          </div>
        </div>

        <!-- Key Highlights (EN / VI / JA) -->
        <div class="body-group">
          <h2 class="body-group__title">
            <I18nText t={labels.highlights} />
          </h2>
          <div class="body-group__contents">
            <ul class="highlight-list" data-i18n-lang="en">
              {project.highlights.en.map((h) => (
                <li class="highlight-list__item">
                  <span class="dot" aria-hidden="true"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <ul class="highlight-list" data-i18n-lang="vi">
              {project.highlights.vi.map((h) => (
                <li class="highlight-list__item">
                  <span class="dot" aria-hidden="true"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <ul class="highlight-list" data-i18n-lang="ja">
              {project.highlights.ja.map((h) => (
                <li class="highlight-list__item">
                  <span class="dot" aria-hidden="true"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Outcome & Source Code Link -->
        <div class="body-group">
          <h2 class="body-group__title">
            <I18nText t={labels.impact} />
          </h2>
          <div class="body-group__contents">
            <I18nText tag="p" t={project.story.impact} />
            <div class="repo-cta">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="repo-cta__btn u-en"
              >
                <span>
                  <I18nText t={labels.exploreGithub} /> ({project.title})
                </span>
                <svg width="20" height="20" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M33.6508 10.7936L5.47619 39.0476C4.84127 39.6825 4.08677 40 3.2127 40C2.34074 40 1.5873 39.6825 0.95238 39.0476C0.317459 38.4127 0 37.6582 0 36.7841C0 35.9122 0.317459 35.1587 0.95238 34.5238L29.2064 6.34921H5.07936C4.17989 6.34921 3.4254 6.0455 2.81587 5.43809C2.20847 4.82857 1.90476 4.07407 1.90476 3.1746C1.90476 2.27513 2.20847 1.52064 2.81587 0.911112C3.4254 0.303704 4.17989 0 5.07936 0H36.8254C37.7249 0 38.4783 0.303704 39.0857 0.911112C39.6952 1.52064 40 2.27513 40 3.1746V34.9206C40 35.8201 39.6952 36.5735 39.0857 37.181C38.4783 37.7905 37.7249 38.0952 36.8254 38.0952C35.9259 38.0952 35.1725 37.7905 34.5651 37.181C33.9556 36.5735 33.6508 35.8201 33.6508 34.9206V10.7936Z" fill="#ffffff" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Lightbox Modal for Screenshots -->
      <div class="screenshot-lightbox" id="screenshot-lightbox" aria-hidden="true">
        <button type="button" class="screenshot-lightbox__close u-en" id="lightbox-close-btn">
          × Close
        </button>
        <img id="lightbox-img" src="" alt="Fullscreen project screenshot" />
      </div>

      <!-- Next Case Preview -->
      <div class="p-single-next">
        <div class="p-single-next__background" aria-hidden="true">
          <div class="c-marquee-track u-en">
            <p><span>{nextProject.marqueeText}</span></p>
            <p><span>{nextProject.marqueeText}</span></p>
          </div>
        </div>

        <div class="p-single-next__main">
          <a
            href={`${baseUrl}/cases/${nextProject.slug}/`}
            class="p-single-next__main-item"
            data-stalker="detail"
            data-nav-link
          >
            <span class="p-single-next__eyebrow">
              <I18nText t={labels.nextCase} />
            </span>
            <p class="title u-en"><span>{nextProject.caseLabel}</span></p>
            <div class="image">
              <CaseVisual type={nextProject.visualType} />
            </div>
            <p class="text">
              {nextProject.title} — <I18nText t={nextProject.description} />
            </p>
            <div class="tags">
              {nextProject.tech.slice(0, 3).map((t) => (
                <span class="c-tag">{t}</span>
              ))}
            </div>
          </a>
        </div>
      </div>

      <!-- Back to the list -->
      <div class="p-single-back">
        <a href={`${baseUrl}/cases/`} class="p-single-back__text u-en c-clone-link" data-nav-link>
          <svg class="arrow-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6.34921 10.7936L34.5238 39.0476C35.1587 39.6825 35.9132 40 36.7873 40C37.6593 40 38.4127 39.6825 39.0476 39.0476C39.6825 38.4127 40 37.6582 40 36.7841C40 35.9122 39.6825 35.1587 39.0476 34.5238L10.7936 6.34921H34.9206C35.8201 6.34921 36.5746 6.0455 37.1841 5.43809C37.7915 4.82857 38.0952 4.07407 38.0952 3.1746C38.0952 2.27513 37.7915 1.52064 37.1841 0.911112C36.5746 0.303704 35.8201 0 34.9206 0H3.1746C2.27513 0 1.52169 0.303704 0.914288 0.911112C0.304764 1.52064 0 2.27513 0 3.1746V34.9206C0 35.8201 0.304764 36.5735 0.914288 37.181C1.52169 37.7905 2.27513 38.0952 3.1746 38.0952C4.07407 38.0952 4.82751 37.7905 5.43492 37.181C6.04445 36.5735 6.34921 35.8201 6.34921 34.9206V10.7936Z" fill="#5BB2F6" />
          </svg>
          <span class="label">
            <span class="label-text"><I18nText t={labels.backToList} /></span>
            <span class="label-text label-text--clone" aria-hidden="true"><I18nText t={labels.backToList} /></span>
          </span>
        </a>
        <small class="p-single-copyright">&copy; {profileInfo.name}</small>
      </div>
    </div>
  </main>
</Base>

<script>
  function initCaseInteractiveFeatures() {
    // 1. Screenshot Gallery Tab Switching & Lightbox
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-shot-idx]');
    const slides = document.querySelectorAll<HTMLElement>('[data-shot-slide]');
    const lightbox = document.getElementById('screenshot-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close-btn');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-shot-idx');
        tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
        slides.forEach((s) =>
          s.classList.toggle('is-active', s.getAttribute('data-shot-slide') === idx)
        );
      });
    });

    // 3D Hover Tilt & Lightbox Click on Screenshot Frame
    document.querySelectorAll<HTMLElement>('.screenshot-frame').forEach((frame) => {
      frame.addEventListener('mousemove', (e) => {
        const rect = frame.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        frame.style.transform = `perspective(900px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg) scale(1.01)`;
      });
      frame.addEventListener('mouseleave', () => {
        frame.style.transform = 'perspective(900px) rotateY(0deg) rotateX(0deg) scale(1)';
      });
      frame.addEventListener('click', () => {
        const src = frame.getAttribute('data-lightbox-src');
        if (src && lightbox && lightboxImg) {
          lightboxImg.src = src;
          lightbox.classList.add('is-open');
          lightbox.setAttribute('aria-hidden', 'false');
        }
      });
    });

    const closeLightbox = () => {
      if (lightbox) {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
      }
    };
    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // 2. Live Interactive 3D Galaxy & Solar System Canvas Simulator
    const canvas = document.getElementById('portfolio-galaxy-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const readout = document.getElementById('sim-scale-readout');
    const modeBtns = document.querySelectorAll<HTMLButtonElement>('[data-sim-mode]');
    let currentMode: 'galaxy' | 'solar' | 'supernova' = 'galaxy';
    let tiltX = 0.58;
    let rotZ = 0;
    let isDragging = false;
    let lastX = 0;
    let lastY = 0;
    let shockwaveRadius = 10;

    // Generate 950 spiral galaxy particles
    const stars = Array.from({ length: 950 }, (_, i) => {
      const arm = i % 4;
      const r = 14 + Math.pow(Math.random(), 1.15) * 235;
      const armOffset = (arm * Math.PI) / 2;
      const spiralAngle = r * 0.022 + armOffset + (Math.random() - 0.5) * 0.48;
      const isCore = r < 48;
      const isHII = i % 29 === 0 && r > 60;
      const color = isCore
        ? '#F8C98B'
        : isHII
          ? '#F472B6'
          : i % 3 === 0
            ? '#67E8F9'
            : '#7AA8FF';
      return {
        r,
        theta: spiralAngle,
        speed: (0.008 / Math.sqrt(r * 0.08 + 1)) * 1.4,
        size: isCore ? 2.1 : isHII ? 2.8 : 1.3 + Math.random() * 1.2,
        color,
      };
    });

    const planets = [
      { name: 'Sao Thủy', r: 36, speed: 0.032, size: 3.2, color: '#94A3B8', angle: 0.4 },
      { name: 'Sao Kim', r: 58, speed: 0.022, size: 4.6, color: '#FDE68A', angle: 1.8 },
      { name: 'Trái Đất', r: 88, speed: 0.015, size: 5.5, color: '#38BDF8', angle: 3.1, hasMoon: true },
      { name: 'Sao Hỏa', r: 118, speed: 0.011, size: 4.2, color: '#FB923C', angle: 4.5 },
      { name: 'Sao Mộc', r: 162, speed: 0.007, size: 9.2, color: '#FBBF24', angle: 0.9 },
      { name: 'Sao Thổ', r: 212, speed: 0.005, size: 7.8, color: '#FDE047', angle: 2.4, hasRings: true },
      { name: 'Sao Thiên Vương', r: 256, speed: 0.0035, size: 6.0, color: '#67E8F9', angle: 5.1 },
    ];

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const m = btn.getAttribute('data-sim-mode') as 'galaxy' | 'solar' | 'supernova';
        if (!m) return;
        currentMode = m;
        if (m === 'supernova') shockwaveRadius = 8;
        modeBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (readout) {
          readout.textContent =
            m === 'galaxy'
              ? 'SCALE: 5.0 kpc (~16,300 ly) • R₀ = 8.178 kpc'
              : m === 'solar'
                ? 'SCALE: 2.5 AU (0.000012 pc) • HỆ MẶT TRỜI & SAO CHỔI HALLEY'
                : 'LAB VẬT LÝ: BỘ TÍCH PHÂN LEAPFROG & SÓNG XUNG KÍCH SIÊU TÂN TINH';
        }
      });
    });

    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      if (currentMode === 'supernova') shockwaveRadius = 8;
    });
    window.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      rotZ += dx * 0.007;
      tiltX = Math.max(0.28, Math.min(0.92, tiltX + dy * 0.004));
      lastX = e.clientX;
      lastY = e.clientY;
    });
    window.addEventListener('pointerup', () => {
      isDragging = false;
    });

    let t = 0;
    let animId = 0;
    const render = () => {
      t += 1;
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h / 2;

      ctx.fillStyle = '#040711';
      ctx.fillRect(0, 0, w, h);

      // Radial cosmic glow
      const bgGrad = ctx.createRadialGradient(cx, cy, 10, cx, cy, 290);
      bgGrad.addColorStop(0, currentMode === 'solar' ? 'rgba(245, 158, 11, 0.16)' : 'rgba(122, 168, 255, 0.18)');
      bgGrad.addColorStop(1, 'rgba(3, 5, 9, 0)');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, w, h);

      if (currentMode === 'galaxy' || currentMode === 'supernova') {
        // Draw rotating 4-arm spiral galaxy
        for (const s of stars) {
          s.theta += s.speed;
          const a = s.theta + rotZ;
          const x = cx + Math.cos(a) * s.r;
          const y = cy + Math.sin(a) * s.r * tiltX;
          ctx.fillStyle = s.color;
          ctx.globalAlpha = 0.82;
          ctx.beginPath();
          ctx.arc(x, y, s.size, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;

        // Sgr A* Core
        const coreGrad = ctx.createRadialGradient(cx, cy, 2, cx, cy, 44);
        coreGrad.addColorStop(0, '#FFFFFF');
        coreGrad.addColorStop(0.35, '#F8C98B');
        coreGrad.addColorStop(1, 'rgba(248, 201, 139, 0)');
        ctx.fillStyle = coreGrad;
        ctx.beginPath();
        ctx.arc(cx, cy, 44, 0, Math.PI * 2);
        ctx.fill();

        // Solar System Pin at Orion Spur
        const sunAngle = t * 0.003 + rotZ + 1.1;
        const sx = cx + Math.cos(sunAngle) * 135;
        const sy = cy + Math.sin(sunAngle) * 135 * tiltX;
        ctx.strokeStyle = '#67E8F9';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(sx, sy, 8 + Math.sin(t * 0.08) * 2, 0, Math.PI * 2);
        ctx.stroke();
        ctx.fillStyle = '#67E8F9';
        ctx.font = '600 11px monospace';
        ctx.fillText('☀ Hệ Mặt Trời (8.18 kpc)', sx + 12, sy + 4);

        if (currentMode === 'supernova') {
          shockwaveRadius = (shockwaveRadius + 2.4) % 240;
          const snX = cx + Math.cos(rotZ - 0.7) * 95;
          const snY = cy + Math.sin(rotZ - 0.7) * 95 * tiltX;
          ctx.strokeStyle = '#F472B6';
          ctx.lineWidth = 2.5;
          ctx.globalAlpha = Math.max(0, 1 - shockwaveRadius / 240);
          ctx.beginPath();
          ctx.arc(snX, snY, shockwaveRadius, 0, Math.PI * 2);
          ctx.stroke();
          ctx.strokeStyle = '#67E8F9';
          ctx.beginPath();
          ctx.arc(snX, snY, shockwaveRadius * 0.72, 0, Math.PI * 2);
          ctx.stroke();
          ctx.globalAlpha = 1;
        }
      } else {
        // SOLAR SYSTEM 3D ORRERY MODE
        // Sun
        const sunGrad = ctx.createRadialGradient(cx, cy, 4, cx, cy, 32);
        sunGrad.addColorStop(0, '#FFFFFF');
        sunGrad.addColorStop(0.4, '#FDE047');
        sunGrad.addColorStop(1, 'rgba(245, 158, 11, 0)');
        ctx.fillStyle = sunGrad;
        ctx.beginPath();
        ctx.arc(cx, cy, 32, 0, Math.PI * 2);
        ctx.fill();

        for (const p of planets) {
          p.angle += p.speed;
          // Orbit ellipse
          ctx.strokeStyle = 'rgba(148, 163, 184, 0.22)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.ellipse(cx, cy, p.r, p.r * tiltX, 0, 0, Math.PI * 2);
          ctx.stroke();

          const px = cx + Math.cos(p.angle + rotZ) * p.r;
          const py = cy + Math.sin(p.angle + rotZ) * p.r * tiltX;

          if (p.hasRings) {
            ctx.strokeStyle = '#FDE68A';
            ctx.lineWidth = 2.2;
            ctx.beginPath();
            ctx.ellipse(px, py, 15, 5.5, -0.35, 0, Math.PI * 2);
            ctx.stroke();
          }

          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(px, py, p.size, 0, Math.PI * 2);
          ctx.fill();

          if (p.hasMoon) {
            const moonAngle = t * 0.09;
            const mx = px + Math.cos(moonAngle) * 14;
            const my = py + Math.sin(moonAngle) * 14 * tiltX;
            ctx.fillStyle = '#E2E8F0';
            ctx.beginPath();
            ctx.arc(mx, my, 2.2, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#67E8F9';
            ctx.font = '600 10.5px monospace';
            ctx.fillText('🌍 Trái Đất + Mặt Trăng', px + 10, py - 8);
          }
        }

        // Halley's Comet with antisolar ion tail
        const cometAngle = t * 0.012 + rotZ;
        const cometX = cx + Math.cos(cometAngle) * 195 + 45;
        const cometY = cy + Math.sin(cometAngle) * 85 * tiltX - 20;
        const dx = cometX - cx;
        const dy = cometY - cy;
        const len = Math.hypot(dx, dy) || 1;
        const ux = dx / len;
        const uy = dy / len;

        const tailGrad = ctx.createLinearGradient(cometX, cometY, cometX + ux * 68, cometY + uy * 68);
        tailGrad.addColorStop(0, 'rgba(103, 232, 249, 0.9)');
        tailGrad.addColorStop(1, 'rgba(103, 232, 249, 0)');
        ctx.strokeStyle = tailGrad;
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(cometX, cometY);
        ctx.lineTo(cometX + ux * 68, cometY + uy * 68);
        ctx.stroke();

        ctx.fillStyle = '#FFFFFF';
        ctx.beginPath();
        ctx.arc(cometX, cometY, 3.8, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#67E8F9';
        ctx.font = '600 10.5px monospace';
        ctx.fillText('☄ Sao Chổi Halley', cometX + 8, cometY - 8);
      }

      animId = requestAnimationFrame(render);
    };

    render();
    document.addEventListener(
      'astro:before-preparation',
      () => cancelAnimationFrame(animId),
      { once: true }
    );
  }

  initCaseInteractiveFeatures();
  document.addEventListener('astro:page-load', initCaseInteractiveFeatures);
</script>

