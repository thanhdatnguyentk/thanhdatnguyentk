---
import '../styles/global.css';
import '../styles/animations.css';
import { profileInfo } from '../data/projects';

interface Props {
  title?: string;
  description?: string;
  namespace?: 'home' | 'case' | 'single';
}

const {
  title = 'Nguyễn Thành Đạt — AI Engineer in training',
  description = 'Portfolio of Nguyễn Thành Đạt (thanhdatnguyentk), a 3rd-year IT student at UIT-VNUHCM specialising in Machine Learning, NLP, Computer Vision, and LLM systems.',
  namespace = 'home',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://thanhdatnguyentk.github.io/thanhdatnguyentk/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteUrl).toString();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=5" />
    <meta name="theme-color" content="#f4f9fd" />

    <!-- Synchronize language (EN / VI / JA) before first paint to prevent mixed language flash -->
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var urlLang = params.get('lang');
          var saved = localStorage.getItem('portfolio_lang');
          var lang =
            urlLang === 'en' || urlLang === 'vi' || urlLang === 'ja'
              ? urlLang
              : saved === 'en' || saved === 'vi' || saved === 'ja'
                ? saved
                : 'en';
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);
          localStorage.setItem('portfolio_lang', lang);
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Nguyễn Thành Đạt — AI Portfolio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />

    <!-- Fonts: Mali & Baloo 2 (Full Vietnamese + Cute Comic Display) + Plus Jakarta Sans + Noto Sans JP + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=JetBrains+Mono:wght@400;600&family=Mali:ital,wght@0,500;0,600;0,700;1,600&family=Noto+Sans+JP:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profileInfo.name,
      alternateName: profileInfo.handle,
      jobTitle: 'AI Engineer in Training',
      url: canonicalURL,
      sameAs: [profileInfo.github],
      knowsAbout: [
        'Machine Learning',
        'Natural Language Processing',
        'Computer Vision',
        'Large Language Models',
        'CUDA GPU Programming',
      ],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Information Technology (UIT) — VNU-HCM',
      },
    })} />
  </head>

  <body class="l-body">
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="l-wrapper" data-namespace={namespace}>
      <slot />
    </div>

    <!-- Floating Stalker Cursor (220px Orange Circle) -->
    <div class="c-stalker" id="stalker-cursor" aria-hidden="true">
      <span id="stalker-text">Hey!</span>
      <svg id="stalker-arrow" style="display:none" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M33.6508 10.7936L5.47619 39.0476C4.84127 39.6825 4.08677 40 3.2127 40C2.34074 40 1.5873 39.6825 0.95238 39.0476C0.317459 38.4127 0 37.6582 0 36.7841C0 35.9122 0.317459 35.1587 0.95238 34.5238L29.2064 6.34921H5.07936C4.17989 6.34921 3.4254 6.0455 2.81587 5.43809C2.20847 4.82857 1.90476 4.07407 1.90476 3.1746C1.90476 2.27513 2.20847 1.52064 2.81587 0.911112C3.4254 0.303704 4.17989 0 5.07936 0H36.8254C37.7249 0 38.4783 0.303704 39.0857 0.911112C39.6952 1.52064 40 2.27513 40 3.1746V34.9206C40 35.8201 39.6952 36.5735 39.0857 37.181C38.4783 37.7905 37.7249 38.0952 36.8254 38.0952C35.9259 38.0952 35.1725 37.7905 34.5651 37.181C33.9556 36.5735 33.6508 35.8201 33.6508 34.9206V10.7936Z" fill="#ffffff" />
      </svg>
    </div>

    <!-- Orange Curtain Page Transition -->
    <div class="l-transition" id="page-transition" aria-hidden="true"></div>

    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>