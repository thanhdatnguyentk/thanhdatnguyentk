---
import { uiStrings } from '../data/projects';
import I18nText from './I18nText.astro';

interface Repo {
  name: string;
  stargazers_count: number;
  language: string | null;
  forks_count: number;
}

interface UserStats {
  login: string;
  name: string;
  avatar_url: string;
  public_repos: number;
  followers: number;
  following: number;
  total_stars: number;
  top_languages: { lang: string; count: number }[];
}

const username = 'thanhdatnguyentk';

async function fetchStats(): Promise<UserStats | null> {
  try {
    const userRes = await fetch(`https://api.github.com/users/${username}`, {
      headers: { Accept: 'application/vnd.github+json' },
    });
    if (!userRes.ok) return null;
    const user = await userRes.json();

    const reposRes = await fetch(
      `https://api.github.com/users/${username}/repos?per_page=100&sort=updated`,
      { headers: { Accept: 'application/vnd.github+json' } }
    );
    const repos: Repo[] = reposRes.ok ? await reposRes.json() : [];

    const total_stars = repos.reduce((sum, r) => sum + r.stargazers_count, 0);
    const langCount = new Map<string, number>();
    repos.forEach((r) => {
      if (r.language) langCount.set(r.language, (langCount.get(r.language) ?? 0) + 1);
    });
    const top_languages = Array.from(langCount.entries())
      .map(([lang, count]) => ({ lang, count }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 5);

    return {
      login: user.login,
      name: user.name || 'Nguyễn Thành Đạt',
      avatar_url: user.avatar_url,
      public_repos: user.public_repos,
      followers: user.followers,
      following: user.following,
      total_stars,
      top_languages,
    };
  } catch (err) {
    console.warn('[GithubStats] Failed to fetch GitHub data:', err);
    return null;
  }
}

const stats = await fetchStats();
const totalRepos = stats?.top_languages.reduce((s, l) => s + l.count, 0) ?? 0;
---

<div class="c-ghstats">
  {stats ? (
    <div class="c-ghstats__card">
      <div class="c-ghstats__header">
        <img
          src={stats.avatar_url}
          alt={`${stats.name} avatar`}
          width="52"
          height="52"
          class="c-ghstats__avatar"
          loading="lazy"
        />
        <div>
          <p class="c-ghstats__name">{stats.name}</p>
          <a
            href={`https://github.com/${stats.login}`}
            target="_blank"
            rel="noopener noreferrer"
            class="c-ghstats__handle u-mono"
          >
            @{stats.login} ↗
          </a>
        </div>
      </div>

      <div class="c-ghstats__metrics">
        <div class="c-ghstats__metric">
          <span class="val u-en">{stats.public_repos}</span>
          <span class="lbl"><I18nText t={uiStrings.aboutPage.ghRepos} /></span>
        </div>
        <div class="c-ghstats__metric">
          <span class="val u-en">{stats.total_stars}</span>
          <span class="lbl"><I18nText t={uiStrings.aboutPage.ghStars} /></span>
        </div>
        <div class="c-ghstats__metric">
          <span class="val u-en">{stats.followers}</span>
          <span class="lbl"><I18nText t={uiStrings.aboutPage.ghFollowers} /></span>
        </div>
        <div class="c-ghstats__metric">
          <span class="val u-en">{stats.following}</span>
          <span class="lbl"><I18nText t={uiStrings.aboutPage.ghFollowing} /></span>
        </div>
      </div>

      {stats.top_languages.length > 0 && (
        <div class="c-ghstats__langs">
          <p class="c-ghstats__langs-title u-en">
            <I18nText t={uiStrings.aboutPage.ghTopLangs} />
          </p>
          <div class="c-ghstats__bars">
            {stats.top_languages.map((l) => {
              const pct = totalRepos ? Math.round((l.count / totalRepos) * 100) : 0;
              return (
                <div class="c-ghstats__bar-row">
                  <div class="c-ghstats__bar-meta">
                    <span class="lang-name">{l.lang}</span>
                    <span class="lang-pct u-mono">{pct}% ({l.count} repos)</span>
                  </div>
                  <div class="c-ghstats__bar-track">
                    <div class="c-ghstats__bar-fill" style={`width: ${pct}%`}></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="c-ghstats__card">
      <p>
        GitHub:{' '}
        <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" style="color:var(--color-orange);font-weight:700">
          github.com/{username} ↗
        </a>
      </p>
    </div>
  )}
</div>

<style>
  .c-ghstats__card {
    background: var(--color-surface);
    border-radius: 24px;
    padding: 24px;
    margin-block: 16px;
  }

  .c-ghstats__header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .c-ghstats__avatar {
    border-radius: 50%;
    border: 2px solid var(--color-orange);
  }

  .c-ghstats__name {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.25;
  }

  .c-ghstats__handle {
    font-size: 13px;
    color: var(--color-orange);
    font-weight: 600;
  }

  .c-ghstats__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }

  @media (max-width: 520px) {
    .c-ghstats__metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .c-ghstats__metric {
    background: var(--color-white);
    border-radius: 16px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .c-ghstats__metric .val {
    font-size: 24px;
    color: var(--color-orange);
    line-height: 1;
  }

  .c-ghstats__metric .lbl {
    font-size: 11px;
    font-weight: 700;
    opacity: 0.7;
  }

  .c-ghstats__langs-title {
    font-size: 13px;
    margin-bottom: 12px;
    opacity: 0.8;
  }

  .c-ghstats__bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .c-ghstats__bar-meta {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .c-ghstats__bar-track {
    width: 100%;
    height: 8px;
    border-radius: 100vmax;
    background: var(--color-white);
    overflow: hidden;
  }

  .c-ghstats__bar-fill {
    height: 100%;
    border-radius: 100vmax;
    background: var(--color-orange);
  }
</style>