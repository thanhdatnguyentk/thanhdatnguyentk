---
import { stats, profileInfo, uiStrings } from '../data/projects';
import I18nText from './I18nText.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="p-index">
  <h1 class="u-sr">{profileInfo.name} — AI Portfolio</h1>

  <!-- Orange Loading Cover (Mild Sugar Signature Intro) -->
  <div class="p-index-loading" id="home-loading" role="status" aria-label="Loading portfolio">
    <div class="p-index-loading__contents u-en">
      <div class="p-index-loading__contents-cover">
        <p class="text">
          Don’t be shy.<br />Feel free to say
        </p>
        <p class="title">“Hey!”</p>
      </div>
      <!-- Rotating Circular Typography Badge -->
      <svg class="circle" width="320" height="320" viewBox="0 0 320 320" aria-hidden="true">
        <defs>
          <path
            id="loadingCirclePath"
            d="M 160, 160 m -124, 0 a 124,124 0 1,1 248,0 a 124,124 0 1,1 -248,0"
          />
        </defs>
        <text fill="#ffffff" font-family="Righteous, sans-serif" font-size="13.5" letter-spacing="3.2">
          <textPath href="#loadingCirclePath">
            NGUYEN THANH DAT • AI ENGINEER IN THE MAKING • UIT VNU-HCM •
          </textPath>
        </text>
      </svg>
    </div>
    <div class="p-index-loading__filter" aria-hidden="true"></div>
  </div>

  <!-- Interactive Room & Slide-Out Drawer -->
  <div class="p-index-contents" id="home-contents">
    <div class="p-index-contents__room-wrap" id="room-wrap" data-time-mode="afternoon">
      <!-- Time of Day / Ambience Switcher + Quick Hint -->
      <div class="p-index-controls">
        <button
          type="button"
          class="p-index-control-pill u-en"
          id="time-toggle-btn"
          aria-label="Switch room lighting between Afternoon and Night mode"
        >
          <span class="dot"></span>
          <span class="time-lbl-afternoon">
            <I18nText t={uiStrings.home.afternoonLab} />
          </span>
          <span class="time-lbl-night" style="display:none">
            <I18nText t={uiStrings.home.nightLab} />
          </span>
        </button>

        <button
          type="button"
          class="p-index-control-pill p-index-control-pill--cta u-en"
          id="open-drawer-pill"
        >
          <span class="drawer-lbl-open">
            <I18nText t={uiStrings.home.openProfile} />
          </span>
          <span class="drawer-lbl-hide" style="display:none">
            <I18nText t={uiStrings.home.hideProfile} />
          </span>
        </button>
      </div>

      <!-- Illustrated Interactive AI Engineer Room (Afternoon & Night Responsive) -->
      <div
        class="p-index-room-Trigger"
        id="character-trigger"
        role="button"
        tabindex="0"
        data-stalker="hey"
        aria-label="Click to say Hey and open Nguyễn Thành Đạt's profile drawer"
        aria-expanded="false"
      >
        <svg
          class="room-svg"
          viewBox="0 0 1440 900"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="xMidYMid slice"
        >
          <!-- Room Background Wall -->
          <rect class="wall-bg" width="1440" height="900" fill="#E5F2FC" />

          <!-- Subtle Architectural Grid -->
          <g class="room-grid" stroke="#1E2E3E" stroke-opacity="0.06" stroke-width="1.5">
            <line x1="0" y1="680" x2="1440" y2="680" />
            <line x1="280" y1="0" x2="280" y2="680" />
            <line x1="1160" y1="0" x2="1160" y2="680" />
          </g>

          <!-- Large Studio Window (Left-Center) showing HCMC / UIT Sky -->
          <g transform="translate(170, 130)">
            <rect x="0" y="0" width="280" height="360" rx="24" class="window-sky" fill="#F8FCFF" stroke="#1E2E3E" stroke-width="4" />
            <circle cx="200" cy="88" r="36" class="sky-orb" fill="#7CC6FE" />
            <g class="night-stars" opacity="0">
              <circle cx="70" cy="70" r="3" fill="#FFF" />
              <circle cx="120" cy="110" r="2.5" fill="#7CC6FE" />
              <circle cx="85" cy="160" r="2" fill="#FFF" />
              <circle cx="220" cy="180" r="3" fill="#FFF" />
            </g>
            <path d="M20 290 C80 260, 140 275, 260 280 L260 340 L20 340 Z" fill="#7CC6FE" fill-opacity="0.28" />
            <line x1="140" y1="0" x2="140" y2="360" stroke="#1E2E3E" stroke-width="4" />
            <line x1="0" y1="180" x2="280" y2="180" stroke="#1E2E3E" stroke-width="4" />
          </g>

          <!-- Wall Whiteboard: Neural Network & Transformer Architecture -->
          <g transform="translate(520, 120)">
            <rect x="0" y="0" width="420" height="230" rx="18" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="4" />
            <rect x="18" y="18" width="110" height="26" rx="13" fill="#7CC6FE" />
            <text x="73" y="35" text-anchor="middle" fill="#1E2E3E" font-family="Righteous, sans-serif" font-size="12">BERT • RAG • T5</text>

            <g stroke="#1E2E3E" stroke-width="2.5">
              <line x1="65" y1="95" x2="145" y2="75" />
              <line x1="65" y1="95" x2="145" y2="125" />
              <line x1="65" y1="145" x2="145" y2="75" />
              <line x1="65" y1="145" x2="145" y2="125" />
              <line x1="145" y1="75" x2="225" y2="105" />
              <line x1="145" y1="125" x2="225" y2="105" />
            </g>
            <circle cx="65" cy="95" r="11" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="3" />
            <circle cx="65" cy="145" r="11" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="3" />
            <circle cx="145" cy="75" r="11" fill="#7CC6FE" stroke="#1E2E3E" stroke-width="3" />
            <circle cx="145" cy="125" r="11" fill="#7CC6FE" stroke="#1E2E3E" stroke-width="3" />
            <circle cx="225" cy="105" r="13" fill="#1E2E3E" />

            <rect x="268" y="56" width="126" height="92" rx="12" fill="#E5F2FC" stroke="#1E2E3E" stroke-width="2.5" />
            <path d="M284 78 Q305 128 378 132" stroke="#5BB2F6" stroke-width="3.5" stroke-linecap="round" fill="none" />
            <text x="331" y="74" text-anchor="middle" fill="#1E2E3E" font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">loss ↓ 0.012</text>

            <text x="24" y="198" fill="#1E2E3E" font-family="Plus Jakarta Sans, sans-serif" font-size="13" font-weight="700">
              “AI is math, code &amp; coffee.” — UIT-VNUHCM
            </text>
          </g>

          <!-- Bookshelf & GPU Server Rack (Right) -->
          <g transform="translate(1010, 170)">
            <rect x="0" y="0" width="210" height="320" rx="18" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="4" />
            <line x1="0" y1="105" x2="210" y2="105" stroke="#1E2E3E" stroke-width="4" />
            <line x1="0" y1="210" x2="210" y2="210" stroke="#1E2E3E" stroke-width="4" />
            <rect x="24" y="35" width="22" height="68" rx="4" fill="#7CC6FE" stroke="#1E2E3E" stroke-width="2.5" />
            <rect x="50" y="43" width="26" height="60" rx="4" fill="#1E2E3E" />
            <rect x="82" y="38" width="22" height="65" rx="4" fill="#E5F2FC" stroke="#1E2E3E" stroke-width="2.5" transform="rotate(-8 82 38)" />
            <rect x="24" y="130" width="162" height="58" rx="10" fill="#1E2E3E" />
            <circle cx="46" cy="159" r="6" fill="#7CC6FE" class="gpu-pulse" />
            <circle cx="68" cy="159" r="6" fill="#10B981" />
            <text x="132" y="164" text-anchor="middle" fill="#F4F9FD" font-family="JetBrains Mono, monospace" font-size="12" font-weight="600">CUDA • GPU</text>
            <rect x="80" y="256" width="50" height="50" rx="10" fill="#7CC6FE" stroke="#1E2E3E" stroke-width="3" />
            <path d="M105 256 C85 230, 75 240, 72 222 C95 220, 102 238, 105 256 Z" fill="#1E2E3E" />
            <path d="M105 256 C125 226, 138 236, 140 218 C115 218, 108 236, 105 256 Z" fill="#1E2E3E" />
          </g>

          <!-- Main Desk & Dual Monitors + Character Centerpiece -->
          <g transform="translate(0, 20)">
            <g class="character-group" transform="translate(610, 320)">
              <g class="speech-bubble" transform="translate(155, -35)">
                <rect x="0" y="0" width="136" height="48" rx="24" fill="#7CC6FE" stroke="#1E2E3E" stroke-width="3.5" />
                <text x="68" y="30" text-anchor="middle" fill="#1E2E3E" font-family="Righteous, sans-serif" font-size="20">Click “Hey!”</text>
              </g>

              <rect x="58" y="88" width="104" height="90" rx="38" fill="#1E2E3E" />
              <circle cx="110" cy="62" r="42" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="4" />
              <path d="M68 58 C68 26, 152 26, 152 58 C140 42, 85 42, 68 58 Z" fill="#1E2E3E" />
              <rect x="82" y="52" width="24" height="16" rx="5" fill="#7CC6FE" fill-opacity="0.3" stroke="#1E2E3E" stroke-width="3" />
              <rect x="114" y="52" width="24" height="16" rx="5" fill="#7CC6FE" fill-opacity="0.3" stroke="#1E2E3E" stroke-width="3" />
              <line x1="106" y1="60" x2="114" y2="60" stroke="#1E2E3E" stroke-width="3" />
              <path d="M101 78 Q110 85 119 78" stroke="#1E2E3E" stroke-width="3" stroke-linecap="round" fill="none" />
              <path d="M84 90 L110 120 L136 90" stroke="#7CC6FE" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            </g>

            <rect x="220" y="500" width="1000" height="28" rx="14" fill="#1E2E3E" />
            <rect x="280" y="528" width="24" height="220" rx="8" fill="#1E2E3E" />
            <rect x="1136" y="528" width="24" height="220" rx="8" fill="#1E2E3E" />

            <g transform="translate(360, 360)">
              <rect x="0" y="0" width="210" height="124" rx="14" fill="#1E2E3E" />
              <rect x="10" y="10" width="190" height="104" rx="8" fill="#131F2B" />
              <rect x="24" y="26" width="76" height="8" rx="4" fill="#7CC6FE" />
              <rect x="24" y="44" width="130" height="7" rx="3.5" fill="#F4F9FD" opacity="0.7" />
              <rect x="38" y="60" width="110" height="7" rx="3.5" fill="#10B981" opacity="0.85" />
              <rect x="38" y="76" width="94" height="7" rx="3.5" fill="#7CC6FE" opacity="0.85" />
              <rect x="24" y="92" width="60" height="7" rx="3.5" fill="#F4F9FD" opacity="0.5" />
              <rect x="92" y="124" width="26" height="16" fill="#1E2E3E" />
              <rect x="70" y="136" width="70" height="6" rx="3" fill="#1E2E3E" />
            </g>

            <g transform="translate(650, 420)">
              <rect x="0" y="0" width="140" height="76" rx="10" fill="#7CC6FE" stroke="#1E2E3E" stroke-width="4" />
              <circle cx="70" cy="38" r="14" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="3" />
              <rect x="-12" y="74" width="164" height="8" rx="4" fill="#1E2E3E" />
            </g>

            <g transform="translate(855, 444)">
              <path class="coffee-steam" d="M18 -8 Q24 -18 18 -28" stroke="#5BB2F6" stroke-width="3" stroke-linecap="round" fill="none" />
              <path class="coffee-steam" style="animation-delay: 0.9s" d="M32 -6 Q38 -16 32 -26" stroke="#1E2E3E" stroke-width="2.5" stroke-linecap="round" fill="none" />
              <rect x="6" y="0" width="38" height="48" rx="8" fill="#F4F9FD" stroke="#1E2E3E" stroke-width="3.5" />
              <path d="M44 10 H52 C57 10 57 34 52 34 H44" stroke="#1E2E3E" stroke-width="3.5" fill="none" />
              <rect x="12" y="16" width="26" height="12" rx="4" fill="#7CC6FE" />
            </g>
          </g>
        </svg>
      </div>
    </div>

    <!-- Right Slide-Out Profile Drawer (Synchronized EN / VI / JA) -->
    <aside class="p-index-contents__side" id="profile-drawer" aria-label="About Nguyễn Thành Đạt">
      <button
        type="button"
        class="p-index-contents__side-close u-en"
        id="close-drawer-btn"
        aria-label="Close profile drawer"
      >
        <I18nText t={uiStrings.home.close} />
      </button>

      <div class="p-index-contents__side-cover">
        <div class="p-index-contents__side-head">
          <div class="p-index-contents__chip">
            <span class="pulse-dot" aria-hidden="true"></span>
            <I18nText t={uiStrings.home.chip} />
          </div>
          <p class="p-index-contents__side-hey u-en">Hey! 🤝</p>
          <p class="p-index-contents__side-profile-en u-en" style="white-space: pre-line">
            <I18nText t={uiStrings.home.profileEn} />
          </p>
        </div>

        <div class="p-index-contents__side-profile-body">
          <I18nText tag="p" t={uiStrings.home.bio1} />
          <I18nText tag="p" t={uiStrings.home.bio2} />
        </div>

        <!-- Quick Stats Grid -->
        <ul class="p-index-contents__stats" aria-label="Quick highlights">
          {stats.map((s) => (
            <li class="p-index-contents__stat">
              <span class="stat-val u-en">{s.value}</span>
              <span class="stat-lbl">
                <I18nText t={s.label} />
              </span>
            </li>
          ))}
        </ul>

        <!-- Quote Badge -->
        <div class="p-index-contents__quote">
          <p>“<I18nText t={profileInfo.quote} />”</p>
        </div>
      </div>

      <!-- Giant Clone-Hover Link to Cases -->
      <div class="p-index-contents__side-link u-en">
        <a href={`${baseUrl}/cases/`} class="c-clone-link" data-nav-link>
          <span class="label">
            <span class="label-text">
              <I18nText t={uiStrings.home.getToKnowMe} />
            </span>
            <span class="label-text label-text--clone" aria-hidden="true">
              <I18nText t={uiStrings.home.getToKnowMe} />
            </span>
          </span>
          <svg class="arrow-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M33.6508 10.7936L5.47619 39.0476C4.84127 39.6825 4.08677 40 3.2127 40C2.34074 40 1.5873 39.6825 0.95238 39.0476C0.317459 38.4127 0 37.6582 0 36.7841C0 35.9122 0.317459 35.1587 0.95238 34.5238L29.2064 6.34921H5.07936C4.17989 6.34921 3.4254 6.0455 2.81587 5.43809C2.20847 4.82857 1.90476 4.07407 1.90476 3.1746C1.90476 2.27513 2.20847 1.52064 2.81587 0.911112C3.4254 0.303704 4.17989 0 5.07936 0H36.8254C37.7249 0 38.4783 0.303704 39.0857 0.911112C39.6952 1.52064 40 2.27513 40 3.1746V34.9206C40 35.8201 39.6952 36.5735 39.0857 37.181C38.4783 37.7905 37.7249 38.0952 36.8254 38.0952C35.9259 38.0952 35.1725 37.7905 34.5651 37.181C33.9556 36.5735 33.6508 35.8201 33.6508 34.9206V10.7936Z" fill="#5BB2F6" />
          </svg>
        </a>
      </div>
    </aside>
  </div>
</div>

<style>
  .p-index {
    position: relative;
    width: 100%;
    min-height: 100svh;
  }

  .p-index-loading {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100svh;
    z-index: 9999;
    transition: opacity 0.55s var(--expo-ease), visibility 0.55s var(--expo-ease);
  }

  .p-index-loading.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .p-index-loading__contents {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .p-index-loading__contents-cover {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .p-index-loading__contents .text {
    font-size: 16px;
    color: #fff;
    text-align: center;
    margin-bottom: 12px;
    line-height: 1.35;
  }

  .p-index-loading__contents .title {
    font-size: 64px;
    color: #fff;
    line-height: 1;
    text-align: center;
  }

  .p-index-loading__contents .circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: index-loading-circle 22s linear infinite;
    pointer-events: none;
  }

  .p-index-loading__filter {
    position: absolute;
    inset: 0;
    background: var(--color-orange);
    z-index: 0;
  }

  .p-index-contents {
    width: 100%;
    height: 100svh;
    background: var(--color-white);
    overflow: clip;
    position: relative;
  }

  @media (max-width: 767px) {
    .p-index-contents {
      height: auto;
      min-height: 100svh;
    }
  }

  .p-index-contents__room-wrap {
    width: 100%;
    height: 100%;
    position: relative;
    transition: filter 0.5s ease, background-color 0.5s ease;
  }

  @media (max-width: 767px) {
    .p-index-contents__room-wrap {
      height: 76svh;
    }
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .wall-bg {
    fill: #13202E;
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .window-sky {
    fill: #0C1622;
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .sky-orb {
    fill: #F4F9FD;
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .night-stars {
    opacity: 1;
  }

  .p-index-room-Trigger {
    width: 100%;
    height: 100%;
    cursor: pointer;
    position: relative;
  }

  .room-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--expo-ease);
  }

  .p-index-contents.is-drawer-open .room-svg {
    transform: translateX(-14%) scale(0.96);
  }

  @media (max-width: 767px) {
    .p-index-contents.is-drawer-open .room-svg {
      transform: none;
    }
  }

  .speech-bubble {
    animation: float-gentle 3.2s ease-in-out infinite;
  }

  .coffee-steam {
    animation: steam-rise 2.4s ease-in-out infinite;
  }

  .gpu-pulse {
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  .p-index-controls {
    position: absolute;
    left: 40px;
    bottom: 28px;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 767px) {
    .p-index-controls {
      left: 16px;
      bottom: 24px;
    }
  }

  .p-index-control-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100vmax;
    background: rgba(244, 249, 253, 0.92);
    backdrop-filter: blur(8px);
    border: 2px solid var(--color-black);
    font-size: 13px;
    color: var(--color-black);
    transition: transform 0.25s var(--custom-ease), background-color 0.25s ease;
  }

  .p-index-control-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .p-index-control-pill--cta {
    background: var(--color-orange);
    color: #fff;
    border-color: var(--color-orange);
  }

  @media (hover: hover) {
    .p-index-control-pill:hover {
      transform: translateY(-2px);
    }
  }

  .p-index-contents__side {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 700px;
    max-width: 92vw;
    height: 100svh;
    background: var(--color-white);
    border-radius: 40px 0 0 40px;
    padding: 56px 56px 38px;
    z-index: 10;
    box-shadow: -20px 0 60px rgba(30, 46, 62, 0.14);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-orange) transparent;
    transform: translateX(104%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.55s var(--expo-ease),
      opacity 0.45s var(--expo-ease);
  }

  .p-index-contents.is-drawer-open .p-index-contents__side {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 767px) {
    .p-index-contents__side {
      position: relative;
      top: 0;
      right: auto;
      width: 100%;
      max-width: 100%;
      height: auto;
      margin-top: -12svh;
      border-radius: 40px 40px 0 0;
      padding: 36px 24px 36px;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .p-index-contents__side-close {
      display: none !important;
    }
  }

  .p-index-contents__side-close {
    align-self: flex-start;
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 100vmax;
    background: var(--color-surface);
    color: var(--color-black);
    margin-bottom: 16px;
    transition: background-color 0.25s ease;
  }

  .p-index-contents__side-close:hover {
    background: var(--color-orange);
    color: #fff;
  }

  .p-index-contents__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100vmax;
    background: var(--color-surface);
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .p-index-contents__chip .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    animation: pulse-dot 2s infinite;
  }

  .p-index-contents__side-head {
    margin-bottom: 24px;
  }

  .p-index-contents__side-hey {
    font-size: clamp(68px, 8vw, 108px);
    line-height: 1;
    margin-bottom: 12px;
    color: var(--color-black);
  }

