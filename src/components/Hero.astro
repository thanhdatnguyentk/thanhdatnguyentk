---
import { stats, profileInfo, uiStrings } from '../data/projects';
import I18nText from './I18nText.astro';
import SceneFallback from './workspace/SceneFallback.astro';
import WorkspaceApp from './workspace/WorkspaceApp';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="p-index">
  <h1 class="u-sr">{profileInfo.name} — AI Portfolio</h1>

  <!-- Orange Loading Cover (Mild Sugar Signature Intro) -->
  <div class="p-index-loading" id="home-loading" role="status" aria-label="Loading portfolio">
    <div class="p-index-loading__contents u-en">
      <div class="p-index-loading__contents-cover">
        <p class="text">
          Don’t be shy.<br />Feel free to say
        </p>
        <p class="title">“Hey!”</p>
      </div>
      <!-- Rotating Circular Typography Badge -->
      <svg class="circle" width="320" height="320" viewBox="0 0 320 320" aria-hidden="true">
        <defs>
          <path
            id="loadingCirclePath"
            d="M 160, 160 m -124, 0 a 124,124 0 1,1 248,0 a 124,124 0 1,1 -248,0"
          />
        </defs>
        <text fill="#ffffff" font-family="Righteous, sans-serif" font-size="13.5" letter-spacing="3.2">
          <textPath href="#loadingCirclePath">
            NGUYEN THANH DAT • AI ENGINEER IN THE MAKING • UIT VNU-HCM •
          </textPath>
        </text>
      </svg>
    </div>
    <div class="p-index-loading__filter" aria-hidden="true"></div>
  </div>

  <!-- Interactive Room & Slide-Out Drawer -->
  <div class="p-index-contents" id="home-contents">
    <div class="p-index-contents__room-wrap" id="room-wrap" data-time-mode="afternoon">
      <!-- Time of Day / Ambience Switcher + Quick Hint (Preserved for global animations.ts) -->
      <div class="p-index-controls" style="display: none;" aria-hidden="true">
        <button
          type="button"
          class="p-index-control-pill u-en"
          id="time-toggle-btn"
          aria-label="Switch room lighting between Afternoon and Night mode"
        >
          <span class="dot"></span>
          <span class="time-lbl-afternoon">
            <I18nText t={uiStrings.home.afternoonLab} />
          </span>
          <span class="time-lbl-night" style="display:none">
            <I18nText t={uiStrings.home.nightLab} />
          </span>
        </button>

        <button
          type="button"
          class="p-index-control-pill p-index-control-pill--cta u-en"
          id="open-drawer-pill"
        >
          <span class="drawer-lbl-open">
            <I18nText t={uiStrings.home.openProfile} />
          </span>
          <span class="drawer-lbl-hide" style="display:none">
            <I18nText t={uiStrings.home.hideProfile} />
          </span>
        </button>
      </div>

      <!-- Preserved Original 2D SVG AI Engineer's Room Fallback -->
      <SceneFallback />

      <!-- Real-Time WebGL 3D Isometric AI Laboratory Island -->
      <div class="p-index-3d-stage">
        <WorkspaceApp client:only="react" baseUrl={baseUrl} />
      </div>
    </div>

    <!-- Right Slide-Out Profile Drawer (Synchronized EN / VI / JA) -->
    <aside class="p-index-contents__side" id="profile-drawer" aria-label="About Nguyễn Thành Đạt">
      <button
        type="button"
        class="p-index-contents__side-close u-en"
        id="close-drawer-btn"
        aria-label="Close profile drawer"
      >
        <I18nText t={uiStrings.home.close} />
      </button>

      <div class="p-index-contents__side-cover">
        <div class="p-index-contents__side-head">
          <div class="p-index-contents__chip">
            <span class="pulse-dot" aria-hidden="true"></span>
            <I18nText t={uiStrings.home.chip} />
          </div>
          <p class="p-index-contents__side-hey u-en">Hey! 🤝</p>
          <p class="p-index-contents__side-profile-en u-en" style="white-space: pre-line">
            <I18nText t={uiStrings.home.profileEn} />
          </p>
        </div>

        <div class="p-index-contents__side-profile-body">
          <I18nText tag="p" t={uiStrings.home.bio1} />
          <I18nText tag="p" t={uiStrings.home.bio2} />
        </div>

        <!-- Quick Stats Grid -->
        <ul class="p-index-contents__stats" aria-label="Quick highlights">
          {stats.map((s) => (
            <li class="p-index-contents__stat">
              <span class="stat-val u-en">{s.value}</span>
              <span class="stat-lbl">
                <I18nText t={s.label} />
              </span>
            </li>
          ))}
        </ul>

        <!-- Quote Badge -->
        <div class="p-index-contents__quote">
          <p>“<I18nText t={profileInfo.quote} />”</p>
        </div>
      </div>

      <!-- Giant Clone-Hover Link to Cases -->
      <div class="p-index-contents__side-link u-en">
        <a href={`${baseUrl}/cases/`} class="c-clone-link" data-nav-link>
          <span class="label">
            <span class="label-text">
              <I18nText t={uiStrings.home.getToKnowMe} />
            </span>
            <span class="label-text label-text--clone" aria-hidden="true">
              <I18nText t={uiStrings.home.getToKnowMe} />
            </span>
          </span>
          <svg class="arrow-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M33.6508 10.7936L5.47619 39.0476C4.84127 39.6825 4.08677 40 3.2127 40C2.34074 40 1.5873 39.6825 0.95238 39.0476C0.317459 38.4127 0 37.6582 0 36.7841C0 35.9122 0.317459 35.1587 0.95238 34.5238L29.2064 6.34921H5.07936C4.17989 6.34921 3.4254 6.0455 2.81587 5.43809C2.20847 4.82857 1.90476 4.07407 1.90476 3.1746C1.90476 2.27513 2.20847 1.52064 2.81587 0.911112C3.4254 0.303704 4.17989 0 5.07936 0H36.8254C37.7249 0 38.4783 0.303704 39.0857 0.911112C39.6952 1.52064 40 2.27513 40 3.1746V34.9206C40 35.8201 39.6952 36.5735 39.0857 37.181C38.4783 37.7905 37.7249 38.0952 36.8254 38.0952C35.9259 38.0952 35.1725 37.7905 34.5651 37.181C33.9556 36.5735 33.6508 35.8201 33.6508 34.9206V10.7936Z" fill="#5BB2F6" />
          </svg>
        </a>
      </div>
    </aside>
  </div>
</div>

<style>
  .p-index {
    position: relative;
    width: 100%;
    min-height: 100svh;
  }

  .p-index-loading {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100svh;
    z-index: 9999;
    transition: opacity 0.55s var(--expo-ease), visibility 0.55s var(--expo-ease);
  }

  .p-index-loading.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .p-index-loading__contents {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .p-index-loading__contents-cover {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .p-index-loading__contents .text {
    font-size: 16px;
    color: #fff;
    text-align: center;
    margin-bottom: 12px;
    line-height: 1.35;
  }

  .p-index-loading__contents .title {
    font-size: 64px;
    color: #fff;
    line-height: 1;
    text-align: center;
  }

  .p-index-loading__contents .circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: index-loading-circle 22s linear infinite;
    pointer-events: none;
  }

  .p-index-loading__filter {
    position: absolute;
    inset: 0;
    background: var(--color-orange);
    z-index: 0;
  }

  .p-index-contents {
    width: 100%;
    height: 100svh;
    background: var(--color-white);
    overflow: clip;
    position: relative;
  }

  @media (max-width: 767px) {
    .p-index-contents {
      height: auto;
      min-height: 100svh;
    }
  }

  .p-index-contents__room-wrap {
    width: 100%;
    height: 100%;
    position: relative;
    transition: filter 0.5s ease, background-color 0.5s ease;
  }

  @media (max-width: 767px) {
    .p-index-contents__room-wrap {
      height: 100svh;
    }
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .wall-bg {
    fill: #13202E;
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .window-sky {
    fill: #0C1622;
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .sky-orb {
    fill: #F4F9FD;
  }

  .p-index-contents__room-wrap[data-time-mode="night"] .night-stars {
    opacity: 1;
  }

  .p-index-3d-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    transition: transform 0.6s var(--expo-ease);
  }

  .p-index-room-Trigger {
    width: 100%;
    height: 100%;
    cursor: pointer;
    position: relative;
  }

  .room-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--expo-ease);
  }

  .p-index-contents.is-drawer-open .room-svg,
  .p-index-contents.is-drawer-open .p-index-3d-stage {
    transform: translateX(-14%) scale(0.96);
  }

  @media (max-width: 767px) {
    .p-index-contents.is-drawer-open .room-svg,
    .p-index-contents.is-drawer-open .p-index-3d-stage {
      transform: none;
    }
  }

  .speech-bubble {
    animation: float-gentle 3.2s ease-in-out infinite;
  }

  .coffee-steam {
    animation: steam-rise 2.4s ease-in-out infinite;
  }

  .gpu-pulse {
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  .p-index-controls {
    position: absolute;
    left: 40px;
    bottom: 28px;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 767px) {
    .p-index-controls {
      left: 16px;
      bottom: 24px;
    }
  }

  .p-index-control-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100vmax;
    background: rgba(244, 249, 253, 0.92);
    backdrop-filter: blur(8px);
    border: 2px solid var(--color-black);
    font-size: 13px;
    color: var(--color-black);
    transition: transform 0.25s var(--custom-ease), background-color 0.25s ease;
  }

  .p-index-control-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-orange);
  }

  .p-index-control-pill--cta {
    background: var(--color-orange);
    color: #fff;
    border-color: var(--color-orange);
  }

  @media (hover: hover) {
    .p-index-control-pill:hover {
      transform: translateY(-2px);
    }
  }

  .p-index-contents__side {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 700px;
    max-width: 92vw;
    height: 100svh;
    background: var(--color-white);
    border-radius: 40px 0 0 40px;
    padding: 56px 56px 38px;
    z-index: 10;
    box-shadow: -20px 0 60px rgba(30, 46, 62, 0.14);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-orange) transparent;
    transform: translateX(104%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.55s var(--expo-ease),
      opacity 0.45s var(--expo-ease);
  }

  .p-index-contents.is-drawer-open .p-index-contents__side {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 767px) {
    .p-index-contents__side {
      position: relative;
      top: 0;
      right: auto;
      width: 100%;
      max-width: 100%;
      height: auto;
      margin-top: 0;
      border-radius: 32px 32px 0 0;
      padding: 36px 24px 36px;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .p-index-contents__side-close {
      display: none !important;
    }
  }

  .p-index-contents__side-close {
    align-self: flex-start;
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 100vmax;
    background: var(--color-surface);
    color: var(--color-black);
    margin-bottom: 16px;
    transition: background-color 0.25s ease;
  }

  .p-index-contents__side-close:hover {
    background: var(--color-orange);
    color: #fff;
  }

  .p-index-contents__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 100vmax;
    background: var(--color-surface);
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .p-index-contents__chip .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    animation: pulse-dot 2s infinite;
  }

  .p-index-contents__side-head {
    margin-bottom: 24px;
  }

  .p-index-contents__side-hey {
    font-size: clamp(68px, 8vw, 108px);
    line-height: 1;
    margin-bottom: 12px;
    color: var(--color-black);
  }

  .p-index-contents__side-profile-en {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.18;
    color: var(--color-black);
  }

  .p-index-contents__side-profile-body {
    font-size: 15.5px;
    line-height: 1.8;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .p-index-contents__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  @media (max-width: 520px) {
    .p-index-contents__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .p-index-contents__stat {
    background: var(--color-surface);
    padding: 14px 12px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .p-index-contents__stat .stat-val {
    font-size: 24px;
    color: var(--color-orange);
    line-height: 1;
  }

  .p-index-contents__stat .stat-lbl {
    font-size: 11px;
    font-weight: 700;
    opacity: 0.75;
  }

  .p-index-contents__quote {
    padding: 16px 20px;
    border-left: 4px solid var(--color-orange);
    background: var(--color-surface);
    border-radius: 0 14px 14px 0;
    font-style: italic;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 28px;
  }

  .p-index-contents__side-link {
    width: fit-content;
    margin-left: auto;
    font-size: clamp(36px, 4.6vw, 56px);
    line-height: 1;
    padding-top: 12px;
  }
</style>