---
---

<section class="section contact" id="contact">
  <div class="contact__ambient" aria-hidden="true">
    <div class="contact__blob parallax-blob"></div>
  </div>

  <div class="container contact__inner">
    <h2 class="section-title reveal">Let's build something together.</h2>
    <p class="section-subtitle contact__subtitle reveal" data-delay="1">
      I'm always open to interesting conversations about AI, ML systems,
      research collaborations, or internship opportunities. Drop me a line.
    </p>

    <div class="contact__grid">
      <md-elevated-card class="contact__card contact__card--actions reveal reveal--left" data-delay="2">
        <div class="contact__card-inner">
          <h3 class="contact__card-title">Direct channels</h3>
          <p class="contact__card-desc">
            Fastest way to reach me. I usually reply within a day.
          </p>

          <div class="contact__buttons">
            <md-filled-button href="mailto:23520261@gm.uit.edu.vn" class="contact__btn">
              <span slot="icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <span class="contact__btn-label">
                <span class="contact__btn-label-primary">Email me</span>
                <span class="contact__btn-label-secondary">23520261@gm.uit.edu.vn</span>
              </span>
            </md-filled-button>

            <md-filled-tonal-button href="https://github.com/thanhdatnguyentk" target="_blank" rel="noopener noreferrer" class="contact__btn">
              <span slot="icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 015.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
                </svg>
              </span>
              <span class="contact__btn-label">
                <span class="contact__btn-label-primary">Follow on GitHub</span>
                <span class="contact__btn-label-secondary">@thanhdatnguyentk</span>
              </span>
            </md-filled-tonal-button>

            <md-outlined-button href="https://github.com/thanhdatnguyentk?tab=repositories" target="_blank" rel="noopener noreferrer" class="contact__btn">
              <span slot="icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 18l6-6-6-6"/>
                  <path d="M8 6l-6 6 6 6"/>
                </svg>
              </span>
              Browse my repos
            </md-outlined-button>
          </div>
        </div>
      </md-elevated-card>

      <md-outlined-card class="contact__card contact__card--meta reveal reveal--right" data-delay="3">
        <div class="contact__card-inner">
          <h3 class="contact__card-title">A bit more context</h3>

          <dl class="contact__meta">
            <div class="contact__meta-row">
              <dt>Based in</dt>
              <dd>Ho Chi Minh City, Vietnam 🇻🇳</dd>
            </div>
            <div class="contact__meta-row">
              <dt>Time zone</dt>
              <dd>UTC +07:00</dd>
            </div>
            <div class="contact__meta-row">
              <dt>Studying</dt>
              <dd>UIT — VNU-HCM (3rd year)</dd>
            </div>
            <div class="contact__meta-row">
              <dt>Looking for</dt>
              <dd>Internships, research, AI collabs</dd>
            </div>
            <div class="contact__meta-row">
              <dt>Languages</dt>
              <dd>Vietnamese, English</dd>
            </div>
          </dl>
        </div>
      </md-outlined-card>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--md-sys-color-surface-container-low);
  }

  .contact__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .contact__blob {
    position: absolute;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--md-sys-color-tertiary) 25%, transparent),
      transparent 70%
    );
    filter: blur(100px);
    opacity: 0.65;
    top: 0;
    left: 0;
    will-change: transform;
  }

  .contact__inner {
    position: relative;
    z-index: 1;
  }

  .contact__subtitle {
    margin-bottom: var(--space-7);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .contact__card {
    display: block;
  }

  .contact__card-inner {
    padding: var(--space-6);
  }

  .contact__card-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--md-sys-color-on-surface);
  }

  .contact__card-desc {
    font-size: 14px;
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: var(--space-5);
  }

  .contact__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .contact__btn {
    --md-filled-button-container-shape: 9999px;
    --md-filled-tonal-button-container-shape: 9999px;
    --md-outlined-button-container-shape: 9999px;
  }

  .contact__btn-label {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  .contact__btn-label-primary {
    font-size: 14px;
    font-weight: 500;
  }

  .contact__btn-label-secondary {
    font-size: 11px;
    font-family: var(--font-mono);
    opacity: 0.75;
    margin-top: 2px;
  }

  .contact__meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px dashed var(--md-sys-color-outline-variant);
  }

  .contact__meta-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .contact__meta dt {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--md-sys-color-on-surface-variant);
    flex-shrink: 0;
  }

  .contact__meta dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
    text-align: right;
  }

  @media (min-width: 768px) {
    .contact__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-6);
    }
  }
</style>