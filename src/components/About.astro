---
import { projects, skillGroups, profileInfo, uiStrings } from '../data/projects';
import CaseVisual from './CaseVisual.astro';
import GithubStats from './GithubStats.astro';
import I18nText from './I18nText.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstCase = projects[0];
const s = uiStrings.aboutPage;

const headlineWordsEn = s.headline.en.split(' ');
const headlineWordsVi = s.headline.vi.split(' ');
---

<div class="p-single" id="single-page">
  <div class="p-single-head">
    <p class="p-single-head__eyebrow u-en">
      <I18nText t={s.eyebrow} />
    </p>
    <h1 class="p-single-head__title">
      <span data-i18n-lang="en">
        {headlineWordsEn.map((w, idx) => (
          <span class="word">
            <span class="word__inner" style={`transition-delay: ${Math.min(idx * 25, 600)}ms`}>
              {w}
            </span>
          </span>
        ))}
      </span>
      <span data-i18n-lang="vi">
        {headlineWordsVi.map((w, idx) => (
          <span class="word">
            <span class="word__inner" style={`transition-delay: ${Math.min(idx * 25, 600)}ms`}>
              {w}
            </span>
          </span>
        ))}
      </span>
      <span data-i18n-lang="ja">
        <span class="word">
          <span class="word__inner" style="transition-delay: 80ms">
            {s.headline.ja}
          </span>
        </span>
      </span>
    </h1>
  </div>

  <section class="p-single-contents">
    <div class="category">
      <span class="c-tag"><I18nText t={s.tagRole} /></span>
      <span class="c-tag"><I18nText t={s.tagSchool} /></span>
      <span class="c-tag"><I18nText t={s.tagLocation} /></span>
    </div>

    <div class="scope">
      <div class="scope__item">
        <span class="scope__title"><I18nText t={s.scopeNameLabel} /></span>
        <span class="scope__text">{profileInfo.name}</span>
      </div>
      <div class="scope__item">
        <span class="scope__title"><I18nText t={s.scopeUniLabel} /></span>
        <span class="scope__text">UIT — VNU-HCM</span>
      </div>
      <div class="scope__item">
        <span class="scope__title"><I18nText t={s.scopeFocusLabel} /></span>
        <span class="scope__text">ML, NLP, CV &amp; LLMs</span>
      </div>
    </div>

    <!-- Section 1: Who I Am -->
    <div class="body-group">
      <h2 class="body-group__title">
        <I18nText t={s.whoTitle} />
      </h2>
      <div class="body-group__contents">
        <I18nText tag="p" t={s.whoP1} />
        <I18nText tag="p" t={s.whoP2} />
        <div class="visual-box">
          <div style="width:220px;height:220px">
            <CaseVisual type="about" />
          </div>
        </div>
        <small class="caption">
          <I18nText t={s.whoCaption} />
        </small>
      </div>
    </div>

    <!-- Section 2: What I Do -->
    <div class="body-group">
      <h2 class="body-group__title">
        <I18nText t={s.whatTitle} />
      </h2>
      <div class="body-group__contents">
        <p>
          <b><I18nText t={s.what1Title} /></b><br />
          <I18nText t={s.what1Body} />
        </p>
        <p>
          <b><I18nText t={s.what2Title} /></b><br />
          <I18nText t={s.what2Body} />
        </p>
        <p>
          <b><I18nText t={s.what3Title} /></b><br />
          <I18nText t={s.what3Body} />
        </p>
        <p>
          <b><I18nText t={s.what4Title} /></b><br />
          <I18nText t={s.what4Body} />
        </p>
      </div>
    </div>

    <!-- Section 3: Tech Stack & Tools -->
    <div class="body-group" id="skills">
      <h2 class="body-group__title">
        <I18nText t={s.techTitle} />
      </h2>
      <div class="body-group__contents">
        {skillGroups.map((group) => (
          <div class="skill-block">
            <p class="skill-block__title">
              <I18nText t={group.label} />
            </p>
            <p class="skill-block__sub">
              <I18nText t={group.subtitle} />
            </p>
            <div class="skill-block__pills">
              {group.items.map((item) => (
                <span class="c-tag c-tag--outline">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Section 4: Vision & Goals -->
    <div class="body-group">
      <h2 class="body-group__title">
        <I18nText t={s.visionTitle} />
      </h2>
      <div class="body-group__contents">
        <p>
          <b><I18nText t={s.workflowTitle} /></b><br />
          <I18nText t={s.workflowSteps} />
        </p>
        <p>
          <b><I18nText t={s.shortTermTitle} /></b><br />
          <I18nText t={s.shortTermBody} />
        </p>
        <p>
          <b><I18nText t={s.longTermTitle} /></b><br />
          <I18nText t={s.longTermBody} />
        </p>
      </div>
    </div>

    <!-- Section 5: Live GitHub Activity -->
    <div class="body-group" id="github-stats">
      <h2 class="body-group__title">
        <I18nText t={s.ghTitle} />
      </h2>
      <div class="body-group__contents">
        <I18nText tag="p" t={s.ghDesc} />
        <GithubStats />
      </div>
    </div>
  </section>

  <!-- Next Case Preview (Case 1: JavaTorch) -->
  <div class="p-single-next">
    <div class="p-single-next__background" aria-hidden="true">
      <div class="c-marquee-track u-en">
        <p><span>{firstCase.marqueeText}</span></p>
        <p><span>{firstCase.marqueeText}</span></p>
      </div>
    </div>

    <div class="p-single-next__main">
      <a
        href={`${baseUrl}/cases/${firstCase.slug}/`}
        class="p-single-next__main-item"
        data-stalker="detail"
        data-nav-link
      >
        <span class="p-single-next__eyebrow">
          <I18nText t={uiStrings.caseDetail.nextCase} />
        </span>
        <p class="title u-en"><span>{firstCase.caseLabel}</span></p>
        <div class="image">
          <CaseVisual type={firstCase.visualType} />
        </div>
        <p class="text">
          {firstCase.title} — <I18nText t={firstCase.description} />
        </p>
        <div class="tags">
          {firstCase.tech.slice(0, 3).map((t) => (
            <span class="c-tag">{t}</span>
          ))}
        </div>
      </a>
    </div>
  </div>

  <!-- Back to List Footer -->
  <div class="p-single-back">
    <a href={`${baseUrl}/cases/`} class="p-single-back__text u-en c-clone-link" data-nav-link>
      <svg class="arrow-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6.34921 10.7936L34.5238 39.0476C35.1587 39.6825 35.9132 40 36.7873 40C37.6593 40 38.4127 39.6825 39.0476 39.0476C39.6825 38.4127 40 37.6582 40 36.7841C40 35.9122 39.6825 35.1587 39.0476 34.5238L10.7936 6.34921H34.9206C35.8201 6.34921 36.5746 6.0455 37.1841 5.43809C37.7915 4.82857 38.0952 4.07407 38.0952 3.1746C38.0952 2.27513 37.7915 1.52064 37.1841 0.911112C36.5746 0.303704 35.8201 0 34.9206 0H3.1746C2.27513 0 1.52169 0.303704 0.914288 0.911112C0.304764 1.52064 0 2.27513 0 3.1746V34.9206C0 35.8201 0.304764 36.5735 0.914288 37.181C1.52169 37.7905 2.27513 38.0952 3.1746 38.0952C4.07407 38.0952 4.82751 37.7905 5.43492 37.181C6.04445 36.5735 6.34921 35.8201 6.34921 34.9206V10.7936Z" fill="#FEA831" />
      </svg>
      <span class="label">
        <span class="label-text"><I18nText t={uiStrings.caseDetail.backToList} /></span>
        <span class="label-text label-text--clone" aria-hidden="true"><I18nText t={uiStrings.caseDetail.backToList} /></span>
      </span>
    </a>
    <small class="p-single-copyright">&copy; {profileInfo.name}</small>
  </div>
</div>

<style>
  .skill-block {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px dashed var(--color-border);
  }

  .skill-block:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }

  .skill-block__title {
    font-family: var(--font-en);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 4px !important;
  }

  .skill-block__sub {
    font-size: 13px !important;
    color: var(--color-muted) !important;
    margin-bottom: 12px !important;
  }

  .skill-block__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>