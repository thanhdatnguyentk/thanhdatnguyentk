---
import { projects } from '../data/projects';
---

<section class="section projects" id="projects">
  <div class="container">
    <h2 class="section-title">Featured projects</h2>
    <p class="section-subtitle">
      A selection of things I've built. Click through to read the code, the
      design notes, and the lessons learned along the way.
    </p>

    <div class="projects__grid">
      {projects.map((project, idx) => (
        <article class="projects__item" data-index={idx}>
          <md-outlined-card class="projects__card">
            <div class="projects__card-inner">
              <header class="projects__card-header">
                <span class={`projects__category projects__category--${project.category.toLowerCase().replace(/[^a-z]/g, '')}`}>
                  {project.category}
                </span>
                {project.stars !== undefined && (
                  <span class="projects__stars" aria-label={`${project.stars} stars`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    {project.stars}
                  </span>
                )}
              </header>

              <h3 class="projects__card-title">{project.title}</h3>
              <p class="projects__card-desc">{project.description}</p>

              {project.highlights && (
                <ul class="projects__highlights">
                  {project.highlights.map((h) => (
                    <li class="projects__highlight">
                      <span class="projects__highlight-dot" aria-hidden="true"></span>
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              <footer class="projects__card-footer">
                <ul class="projects__tech">
                  {project.tech.slice(0, 4).map((t) => (
                    <li class="projects__tech-item">{t}</li>
                  ))}
                </ul>

                <a
                  href={project.url}
                  class="projects__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <span>View on GitHub</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7"/>
                    <path d="M7 7h10v10"/>
                  </svg>
                </a>
              </footer>
            </div>
          </md-outlined-card>
        </article>
      ))}
    </div>

    <div class="projects__more">
      <md-outlined-button href="https://github.com/thanhdatnguyentk?tab=repositories" target="_blank" rel="noopener noreferrer">
        <span slot="icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 015.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
          </svg>
        </span>
        See all 44 repositories
      </md-outlined-button>
    </div>
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .projects__card {
    display: block;
    height: 100%;
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
  }

  .projects__card:hover {
    transform: translateY(-6px);
    --md-outlined-card-container-shadow: var(--elevation-3);
  }

  .projects__card-inner {
    padding: var(--space-6);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .projects__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .projects__category {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .projects__category--aiml {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .projects__category--web {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .projects__category--systems {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }

  .projects__stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    color: #d97706;
  }

  .projects__card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-3);
    color: var(--md-sys-color-on-surface);
  }

  .projects__card-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: var(--space-4);
  }

  .projects__highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    background: var(--md-sys-color-surface-container-lowest);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--md-sys-color-outline-variant);
  }

  .projects__highlight {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 13px;
    line-height: 1.5;
    color: var(--md-sys-color-on-surface);
  }

  .projects__highlight-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--md-sys-color-primary);
    margin-top: 8px;
  }

  .projects__card-footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .projects__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .projects__tech-item {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }

  .projects__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-weight: 500;
    font-size: 14px;
    transition: background var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .projects__link:hover {
    background: var(--md-sys-color-secondary);
    transform: translateX(2px);
  }

  .projects__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-7);
  }

  @media (min-width: 768px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .projects__card-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>