---
import { projects, profileInfo, uiStrings } from '../data/projects';
import CaseVisual from './CaseVisual.astro';
import I18nText from './I18nText.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const slides = [
  {
    index: 1,
    id: 'about',
    navLabel: uiStrings.cases.aboutNav,
    title: 'About',
    subtitle: undefined,
    href: `${baseUrl}/cases/about/`,
    visual: 'about' as const,
    text: uiStrings.cases.aboutSummary,
    marquee:
      'From mathematical foundations to scalable AI pipelines. Exploring BERT, Transformers, T5, RAG, and GPU computing at UIT-VNUHCM.',
    tags: ['AI Engineer', 'UIT - VNU-HCM', 'ML / NLP / CV'],
  },
  ...projects.map((p, idx) => ({
    index: idx + 2,
    id: p.slug,
    navLabel: { en: `Case ${idx + 1}`, vi: `Case ${idx + 1}`, ja: `Case ${idx + 1}` },
    title: p.caseLabel,
    subtitle: p.title,
    href: `${baseUrl}/cases/${p.slug}/`,
    visual: p.visualType,
    text: p.description,
    marquee: p.marqueeText,
    tags: [p.category, ...p.tech.slice(0, 3)],
  })),
];

const contactIndex = slides.length + 1;
---

<div class="p-case" id="case-showcase">
  <h1 class="u-sr">Cases &amp; Featured Projects — {profileInfo.name}</h1>

  <div class="p-case-contents">
    <!-- Background 120px Orange Scrolling Marquees (1 per Slide) -->
    {slides.map((slide, idx) => (
      <div
        class={`p-case-contents__background ${idx === 0 ? 'is-active' : ''}`}
        aria-hidden="true"
        data-background={slide.index}
      >
        <div class="c-marquee-track u-en">
          <p><span>{slide.marquee}</span></p>
          <p><span>{slide.marquee}</span></p>
        </div>
      </div>
    ))}

    <!-- Contact Slide Background Marquee -->
    <div
      class="p-case-contents__background"
      aria-hidden="true"
      data-background={contactIndex}
    >
      <div class="c-marquee-track u-en">
        <p><span>Open for AI/ML internships, research collaborations, and engineering conversations in Ho Chi Minh City &amp; beyond.</span></p>
        <p><span>Open for AI/ML internships, research collaborations, and engineering conversations in Ho Chi Minh City &amp; beyond.</span></p>
      </div>
    </div>

    <!-- Foreground Centered Case Cards (About + Case 1..5) -->
    {slides.map((slide, idx) => (
      <div
        class={`p-case-contents__main ${idx === 0 ? 'is-active' : ''}`}
        data-list={slide.index}
        data-case-id={slide.id}
      >
        <a
          href={slide.href}
          class="p-case-contents__main-item"
          data-stalker="detail"
          data-nav-link
        >
          <p class="title u-en">
            <span>{slide.title}</span>
          </p>
          {slide.subtitle && (
            <p class="subtitle u-en">{slide.subtitle}</p>
          )}
          <div class="image">
            <CaseVisual type={slide.visual} />
          </div>
          <p class="text">
            <I18nText t={slide.text} />
          </p>
          <div class="tags">
            {slide.tags.map((tag) => (
              <p class="tag">{tag}</p>
            ))}
          </div>
        </a>
      </div>
    ))}

    <!-- Slide 7: Contact ("Say 'Hey!'") -->
    <div
      class="p-case-contents__main"
      data-list={contactIndex}
      data-case-id="contact"
      id="contact"
    >
      <div class="p-case-contents__main-item p-case-contents__main-item--contact">
        <a
          href={`mailto:${profileInfo.email}`}
          class="title u-en c-clone-link"
        >
          <span class="label">
            <span class="label-text">Say “Hey!”</span>
            <span class="label-text label-text--clone" aria-hidden="true">Say “Hey!”</span>
          </span>
          <svg class="arrow-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M33.6508 10.7936L5.47619 39.0476C4.84127 39.6825 4.08677 40 3.2127 40C2.34074 40 1.5873 39.6825 0.95238 39.0476C0.317459 38.4127 0 37.6582 0 36.7841C0 35.9122 0.317459 35.1587 0.95238 34.5238L29.2064 6.34921H5.07936C4.17989 6.34921 3.4254 6.0455 2.81587 5.43809C2.20847 4.82857 1.90476 4.07407 1.90476 3.1746C1.90476 2.27513 2.20847 1.52064 2.81587 0.911112C3.4254 0.303704 4.17989 0 5.07936 0H36.8254C37.7249 0 38.4783 0.303704 39.0857 0.911112C39.6952 1.52064 40 2.27513 40 3.1746V34.9206C40 35.8201 39.6952 36.5735 39.0857 37.181C38.4783 37.7905 37.7249 38.0952 36.8254 38.0952C35.9259 38.0952 35.1725 37.7905 34.5651 37.181C33.9556 36.5735 33.6508 35.8201 33.6508 34.9206V10.7936Z" fill="#FEA831" />
          </svg>
        </a>
        <p class="title-sub">
          <I18nText t={uiStrings.cases.contactSub} />
        </p>

        <div class="image">
          <CaseVisual type="contact" />
        </div>

        <div class="contact-pills">
          <a href={`mailto:${profileInfo.email}`} class="c-tag">
            ✉ {profileInfo.email}
          </a>
          <a href={profileInfo.github} target="_blank" rel="noopener noreferrer" class="c-tag c-tag--outline">
            GitHub @{profileInfo.handle} ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom-Right Case Dot Navigation (Mild Sugar Signature) -->
    <nav class="p-case-contents__nav" aria-label="Case study navigation">
      <ul class="p-case-contents__nav-list">
        {slides.map((slide, idx) => (
          <li class="p-case-contents__nav-item">
            <button
              class={`button u-en ${idx === 0 ? 'is-current' : ''}`}
              type="button"
              data-nav={slide.index}
            >
              <span class="label">
                <I18nText t={slide.navLabel} />
              </span>
              <span class="dot" aria-hidden="true"></span>
            </button>
          </li>
        ))}
        <li class="p-case-contents__nav-item">
          <button
            class="button u-en"
            type="button"
            data-nav={contactIndex}
          >
            <span class="label">
              <I18nText t={uiStrings.cases.contactNav} />
            </span>
            <span class="dot" aria-hidden="true"></span>
          </button>
        </li>
      </ul>
    </nav>

    <!-- Prev / Next Quick Stepper -->
    <div class="p-case-stepper u-en">
      <button type="button" id="case-prev-btn" aria-label="Previous case">
        <I18nText t={uiStrings.cases.prev} />
      </button>
      <span id="case-counter">1 / {contactIndex}</span>
      <button type="button" id="case-next-btn" aria-label="Next case">
        <I18nText t={uiStrings.cases.next} />
      </button>
    </div>

    <small class="p-case-copyright u-en">&copy; {profileInfo.name} ({profileInfo.handle})</small>
  </div>
</div>

<style>
  .p-case-contents {
    width: 100%;
    height: 100svh;
    overflow: clip;
    position: relative;
    background: var(--color-white);
  }

  .p-case-contents__background {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100svh;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.55s var(--custom-ease), visibility 0.55s var(--custom-ease);
  }

  .p-case-contents__background.is-active {
    opacity: 0.28;
    visibility: visible;
  }

  .p-case-contents__main {
    width: 100%;
    height: 100svh;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(28px);
    transition:
      opacity 0.5s var(--expo-ease),
      transform 0.5s var(--expo-ease),
      visibility 0.5s var(--expo-ease);
    pointer-events: none;
  }

  .p-case-contents__main.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .p-case-contents__main-item {
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 28px 36px;
    border-radius: 36px;
    background: rgba(247, 245, 241, 0.82);
    backdrop-filter: blur(6px);
    border: 1.5px solid rgba(60, 55, 40, 0.07);
    transition: transform 0.35s var(--custom-ease), box-shadow 0.35s var(--custom-ease);
  }

  @media (hover: hover) {
    .p-case-contents__main-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 44px rgba(60, 55, 40, 0.09);
    }
  }

  @media (max-width: 767px) {
    .p-case-contents__main-item {
      padding: 20px;
      margin-inline: 16px;
    }
  }

  .p-case-contents__main-item .title {
    font-size: clamp(48px, 6vw, 64px);
    line-height: 1;
    margin-bottom: 4px;
    color: var(--color-black);
  }

  .p-case-contents__main-item .subtitle {
    font-size: 18px;
    color: var(--color-orange);
    margin-bottom: 12px;
  }

  .p-case-contents__main-item .image {
    width: 240px;
    height: 240px;
    margin-bottom: 18px;
  }

  @media (max-width: 767px) and (max-height: 700px) {
    .p-case-contents__main-item .image {
      width: 170px;
      height: 170px;
      margin-bottom: 10px;
    }
  }

  .p-case-contents__main-item .text {
    width: 400px;
    max-width: 84vw;
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.55;
    text-align: center;
    color: var(--color-black);
  }

  .p-case-contents__main-item .tags {
    width: 400px;
    max-width: 84vw;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .p-case-contents__main-item .tag {
    width: fit-content;
    font-family: var(--font-en);
    font-size: 12px;
    color: #fff;
    line-height: 1;
    background: var(--color-orange);
    border-radius: 100vmax;
    padding: 10px 16px;
  }

  .title-sub {
    font-weight: 700;
    font-size: 16px;
    line-height: 1.5;
    margin-top: 6px;
    margin-bottom: 14px;
    text-align: center;
  }

  .contact-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }

  .p-case-contents__nav {
    position: absolute;
    right: 40px;
    bottom: 24px;
    z-index: 5;
  }

  @media (max-width: 767px) {
    .p-case-contents__nav {
      right: 16px;
      bottom: 20px;
    }
  }

  .p-case-contents__nav-list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .p-case-contents__nav .button {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    line-height: 1.2;
    color: var(--color-black);
    opacity: 0.35;
    cursor: pointer;
    padding: 3px 0;
    transition: opacity 0.35s var(--custom-ease), transform 0.35s var(--custom-ease);
  }

  .p-case-contents__nav .button .dot {
    width: 8px;
    height: 8px;
    background: var(--color-orange);
    border-radius: 50%;
    transition: transform 0.35s var(--custom-ease);
  }

  @media (hover: hover) {
    .p-case-contents__nav .button:hover {
      opacity: 1;
    }
  }

  .p-case-contents__nav .button.is-current {
    opacity: 1;
    font-weight: 700;
  }

  .p-case-contents__nav .button.is-current .dot {
    transform: scale(1.45);
  }

  .p-case-stepper {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    background: var(--color-surface);
    padding: 8px 18px;
    border-radius: 100vmax;
  }

  .p-case-stepper button {
    opacity: 0.7;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .p-case-stepper button:hover {
    opacity: 1;
    color: var(--color-orange);
  }

  .p-case-copyright {
    position: fixed;
    left: 40px;
    bottom: 24px;
    font-size: 12px;
    color: var(--color-black);
    opacity: 0.5;
    z-index: 4;
  }

  @media (max-width: 767px) {
    .p-case-copyright {
      display: none;
    }
  }
</style>